SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-level-token
ALLOWED_CHANNEL_IDS=C01234ABCDE,C56789FGHIJ
PERMISSION_PORT=19276
# Kill idle Claude subprocesses after this many minutes. The next message to
# the thread auto-resumes via `claude --resume <session_id>`. Default: 30.
IDLE_TIMEOUT_MINUTES=30

# Post every intermediate assistant text block (inter-tool preamble) instead of
# just the final message. Off by default — see README. Set to 1 to enable.
#POST_INTERMEDIATE_TEXT=1
